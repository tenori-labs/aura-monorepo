// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// Embedded type for AI Analysis
type AiAnalysis {
  category        String
  confidence      Float
  keywords        String[]
  validity        String // "Likely Valid" | "Needs Review" | "Invalid"
  validityReason  String
}

model IncidentReport {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId
  userId          String?
  userEmail       String?
  incidentType    String
  dateTime        DateTime
  location        String
  description     String
  email           String?
  mediaBase64     String?
  mediaType       String?
  mediaFileName   String?
  aiAnalysis      AiAnalysis?
  status          String       @default("pending")
  assignedTo      String?      // faculty user ID (from Supabase)
  assignedToEmail String?      // faculty email for display
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model ConsentRecord {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  userId         String
  userEmail      String
  fullName       String
  studentId      String?
  course         String?
  section        String?
  consentVersion String   @default("UGC-2009-v1")
  ipAddress      String?
  userAgent      String?
  signedAt       DateTime @default(now())
}

model CategoryAssignment {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  category     String   @unique  // e.g. "Harassment/Bullying"
  facultyId    String             // Supabase user ID
  facultyEmail String             // for display
  assignedBy   String?            // admin who made the assignment
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

